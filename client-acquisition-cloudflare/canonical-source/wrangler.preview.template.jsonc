{
  "name": "outreach-x-signal-scout",
  "main": "v2-preview-smoke.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-08",
  "keep_vars": true,
  "secrets": {
    "required": ["RESEARCH_CONTROL_SECRET", "GOOGLE_SERVICE_ACCOUNT_JSON"]
  },
  "vars": {
    "ACQ2_CANARY_TOKEN": "__ACQ2_CANARY_TOKEN__",
    "ACQ2_CANARY_EXPIRES_AT": "__ACQ2_CANARY_EXPIRES_AT__",
    "CLIENT_ACQUISITION_V2_WRITE_ENABLED": "true",
    "DRY_RUN": "true",
    "ENVIRONMENT": "preview-smoke-canary",
    "GOOGLE_SPREADSHEET_ID": "1CTeyNPXZWo2ZSSKFis2t3ber0P0b9OXgiRNKaBjVuSQ",
    "KEENABLE_MCP_URL": "https://api.keenable.ai/mcp",
    "LEAD_OUTREACH_SPREADSHEET_ID": "1fXHlnCqsw6KvKub4UtqHyb5MwUUPvqTZ9QvPp1IPG-E",
    "SCHEDULED_WRITES_ENABLED": "false",
    "SCHEDULED_WRITE_SOURCES": ""
  },
  "triggers": {
    "crons": []
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
